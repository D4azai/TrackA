# ============================================================
# Railway deployment — paste these into:
#   TrackA → Variables (Railway dashboard)
# ============================================================

# =============================
# Core (REQUIRED)
# =============================
# On Railway, use the reference syntax so values are linked automatically:
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

# =============================
# Runtime
# =============================
# PORT is injected automatically by Railway — do NOT set it manually
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# =============================
# Security (REQUIRED)
# =============================
ADMIN_API_KEY=replace-with-a-secure-random-key

# CORS: add your actual frontend URL(s)
CORS_ORIGINS=["https://your-frontend.vercel.app","https://your-custom-domain.com"]

# ALLOWED_HOSTS: keep ["*"] on Railway (Railway uses dynamic hostnames)
ALLOWED_HOSTS=["*"]

# =============================
# Cache
# =============================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# =============================
# Database pool
# =============================
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# =============================
# Recommendation tuning
# =============================
WEIGHT_POPULARITY=0.25
WEIGHT_HISTORY=0.35
WEIGHT_RECENCY=0.20
WEIGHT_NEWNESS=0.10
WEIGHT_ENGAGEMENT=0.10
MAX_LIMIT=100
MIN_SCORE_THRESHOLD=0.0
RECOMMENDATION_ALGORITHM_VERSION=2026.06.stock-aware-v1

# =============================
# Precomputed storage & refresh
# =============================
PRECOMPUTED_STORE_LIMIT=100
PRECOMPUTED_FRESHNESS_SECONDS=1800
SERVE_STALE_PRECOMPUTED=true
SYNC_RECOMPUTE_FALLBACK_ENABLED=false
REFRESH_ACTIVE_SELLERS_LOOKBACK_DAYS=30
REFRESH_ACTIVE_SELLERS_LIMIT=500
REFRESH_EVENT_PRIORITY=150
REFRESH_SCHEDULE_PRIORITY=100
REFRESH_MANUAL_PRIORITY=200
REFRESH_MAX_ATTEMPTS=3

# =============================
# Worker
# =============================
POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=10
DRAIN_INTERVAL_MINUTES=5
ENQUEUE_INTERVAL_MINUTES=30

# =============================
# Kafka (optional — leave empty if not using Kafka on Railway)
# =============================
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_REFRESH_TOPIC=recommendation_refresh
